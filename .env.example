# Environment variables for configuring the service.
# Rename this file to `.env` and uncomment/set values as needed.

# Port for the Express server to listen on. Defaults to 3000.
# PORT=3000

# Redis connection details. Defaults to localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379

# GEMINI_API_KEY=YOUR_API_KEY_HERE # Not used by this prototype.
